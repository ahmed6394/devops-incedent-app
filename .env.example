# Copy this file to .env and adjust as needed. The Compose file falls back to
# sensible defaults, so a .env file is optional.

# --- PostgreSQL (used by the database service and backend) ---
POSTGRES_DB=incidentdb
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me

# --- Ports published on the host ---
# The backend container always listens on 5000 internally.
BACKEND_PORT=5000
FRONTEND_PORT=3000

# --- Authentication (backend) ---
# Used to sign session cookies. Change to a long random string.
SESSION_SECRET=change_me_to_a_long_random_string
# Initial admin account, created automatically on first start.
# Change the password after your first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
